<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode Condition="'$(IsPackable)' == 'true'">Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>PinkRooster</Authors>
    <Copyright>Copyright (c) 2026 Jan Versteeg</Copyright>
      <Company>PinkRooster</Company>
        <PackageIcon>icon.png</PackageIcon>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Version>0.1.0-preview.1</Version>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/pinkroosterai/PinkRooster.Extensions.AI.Antigravity</PackageProjectUrl>
        <RepositoryUrl>https://github.com/pinkroosterai/PinkRooster.Extensions.AI.Antigravity</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>
    <PropertyGroup>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
