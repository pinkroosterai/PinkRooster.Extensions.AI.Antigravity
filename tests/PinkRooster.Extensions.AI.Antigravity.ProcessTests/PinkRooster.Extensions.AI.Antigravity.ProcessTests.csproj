<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PinkRooster.Extensions.AI.Antigravity\PinkRooster.Extensions.AI.Antigravity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\PinkRooster.Extensions.AI.Antigravity.FakeAgy\PinkRooster.Extensions.AI.Antigravity.FakeAgy.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The fake agy is copied next to the tests so they can start it like the real executable. -->
  <Target Name="CopyFakeAgy" AfterTargets="Build">
    <ItemGroup>
      <FakeAgyFile Include="$(MSBuildThisFileDirectory)..\..\tools\PinkRooster.Extensions.AI.Antigravity.FakeAgy\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeAgyFile)" DestinationFolder="$(OutDir)fakeagy/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
